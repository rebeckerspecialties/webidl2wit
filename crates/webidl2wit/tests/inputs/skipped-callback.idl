callback Listener = undefined (long value);

interface Source {
    undefined listen(Listener listener);
    attribute Listener? handler;
    undefined stop();
};

dictionary SourceInit {
    Listener onReady;
    boolean autoStart = false;
};

typedef Listener? OptionalListener;

interface Sink {
    undefined accept(OptionalListener listener);
    long count();
};

// Consumers declared ahead of the definitions they refer to.
interface Early {
    undefined accept(ListenerChain listener);
    attribute ListenerAlias? handler;
    undefined notify(LateListener listener);
    long count();
};

typedef ListenerAlias ListenerChain;
typedef Listener ListenerAlias;
callback LateListener = undefined ();
